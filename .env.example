# Base URL for the FrontierOS API. In local development Vite proxies /api to
# VITE_BACKEND_URL (defaults to http://localhost:8080), so leaving VITE_API_URL
# unset keeps the frontend talking to the Vite dev server over same-origin.
#
# In production (Netlify) the /api/* redirect in netlify.toml fronts the Fly.io
# backend, so you typically do NOT need to set VITE_API_URL there either.
# Override this only when you want the browser to hit a specific backend
# directly (e.g. a preview/staging backend).
# VITE_API_URL=https://frontieros-api.fly.dev/api

# Dev-only: the backend origin that Vite will proxy /api/* to.
# VITE_BACKEND_URL=http://localhost:8080
