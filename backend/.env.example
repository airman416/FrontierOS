# Postgres connection string for the FrontierOS backend. When using Supabase,
# grab the "Connection pooling" URI from Settings → Database and set
# ?sslmode=require. Example:
#   postgres://postgres:<password>@db.<ref>.supabase.co:6543/postgres?sslmode=require
DATABASE_URL=

# OpenRouter key used by /api/generate for graph generation.
OPENROUTER_API_KEY=

# Comma-separated list of frontend origins allowed to call the API.
# Include every Netlify domain you deploy from. Common localhost ports (8888,
# 5173, …) are always merged in when the list is explicit — you do not need to
# list them all unless you use a nonstandard port and want it documented here.
ALLOWED_ORIGINS=http://localhost:5173

# Port the Fastify server binds to. Fly.io expects 8080 by default.
PORT=8080

# Coach used for all writes while auth is disabled. Must be a valid UUID —
# this matches the default row inserted by backend/scripts/seed.ts.
DEFAULT_COACH_ID=00000000-0000-0000-0000-000000000001
